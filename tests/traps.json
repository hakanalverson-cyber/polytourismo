[["wait", 2000], ["js", "(()=>{const t=document.getElementById('ptTitle');if(t)t.click();return 1})()"], ["wait", 2500], ["js", "(()=>{PT8.launch({mode:'mp',rally:true,circuit:true,track:PT8.RING_IDX,laps:1,humans:[{id:'merc',alt:0}],ai:[]});RACE.state='race';window.TP=(nm,back)=>{const T=RACE.T,N=T.N,p=PT8_RING.pts[PT8_RING.marks[nm]];let b=1e18,k=0;for(let i=0;i<N;i++){const d=(T.x[i]-p[0])**2+(T.z[i]-p[1])**2;if(d<b){b=d;k=i}}k=((k-back)%N+N)%N;const c=RACE.cars[0];c.x=T.x[k];c.z=T.z[k];c.y=T.y[k]+.6;c.yaw=T.psi[k];c.vx=c.vy=c.vz=0;c.idx=k;c.unw=k;c.cy=T.psi[k];c.camY=T.y[k]+1;RACE.scene.userData.ringTiles.update(c.x,c.z,1e9);return k};return 1})()"], ["js", "(()=>{const T=RACE.T;window.TPK=(k)=>{const N=T.N;k=((k%N)+N)%N;const c=RACE.cars[0];c.x=T.x[k];c.z=T.z[k];c.y=T.y[k]+.6;c.yaw=T.psi[k];c.vx=c.vy=c.vz=0;c.idx=k;c.unw=k;c.cy=T.psi[k];c.camY=T.y[k]+1;RACE.scene.userData.ringTiles.update(c.x,c.z,1e9)};return T.traps.map(c=>c.a+':'+c.dir).join(' ')})()"], ["js", "TPK(RACE.T.traps[0].a-8)"], ["wait", 2500], ["shot", "trap0"], ["js", "TPK(RACE.T.traps[1].a-8)"], ["wait", 2500], ["shot", "trap1"], ["js", "TPK(RACE.T.traps[2].a-8)"], ["wait", 2500], ["shot", "trap2"], ["js", "TPK(RACE.T.traps[3].a-8)"], ["wait", 2500], ["shot", "trap3"], ["js", "TPK(RACE.T.traps[4].a-8)"], ["wait", 2500], ["shot", "trap4"], ["js", "TPK(RACE.T.traps[5].a-8)"], ["wait", 2500], ["shot", "trap5"]]