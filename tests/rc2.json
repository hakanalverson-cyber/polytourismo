[["wait", 2000], ["js", "(()=>{const t=document.getElementById('ptTitle');if(t)t.click();return 1})()"], ["wait", 2500], ["js", "(()=>{window.VIEW=(tr,frac,h,ah,lat)=>{if(!RACE||!RACE.T||RACE.T.d.id!==(tr==14?14:RACE.T.d.id)||window._vt!==tr){PT8.launch(Object.assign(tr>=14?{rally:true,circuit:true}:{},{mode:'mp',track:tr,laps:1,humans:[{id:'merc',alt:0}],ai:[]}));window._vt=tr}const T=RACE.T,N=T.N,k=Math.floor(N*frac),c=Math.cos(T.psi[k]),s=Math.sin(T.psi[k]),l=lat||0;const cam=new THREE.PerspectiveCamera(60,16/9,.1,3000);const x=T.x[k]+c*l,z=T.z[k]-s*l;cam.position.set(x,T.y[k]+h,z);const k2=(k+(ah||12))%N;cam.lookAt(T.x[k2],T.y[k2]+(h>20?0:1),T.z[k2]);window.drawRace=()=>{R.render(RACE.scene,cam)};return k}; return 1})()"], ["wait", 6000], ["js", "(()=>{VIEW(15,.1,3,10);const out=[];RACE.scene.traverse(m=>{if(m.isMesh&&m.geometry.type==='CylinderGeometry'&&m.geometry.parameters.radiusTop>500)out.push(['pano',m.geometry.parameters.radiusTop,m.position.toArray(),m.parent&&m.parent.position.toArray()])});\nconst f=RACE.scene.fog;out.push(['fog',f&&f.type,f&&f.near,f&&f.far,f&&f.density]);let cnt=0;RACE.scene.traverse(m=>{if(m.isInstancedMesh&&m.geometry.attributes.position.count<120)cnt+=m.count});out.push(['farinst',cnt]);\nconst T=RACE.T;let cx=0,cz=0;for(let i=0;i<T.N;i++){cx+=T.x[i];cz+=T.z[i]}out.push(['c',cx/T.N,cz/T.N,T.bounds]);return JSON.stringify(out)})()"]]