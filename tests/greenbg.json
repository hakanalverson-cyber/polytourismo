[["wait", 2000], ["js", "(()=>{const t=document.getElementById('ptTitle');if(t)t.click();return 1})()"], ["wait", 2500], ["js", "(()=>{PT8.launch({mode:'mp',rally:true,circuit:true,track:PT8.RING_IDX,laps:1,humans:[{id:'merc',alt:0}],ai:[]});RACE.state='race';window.TP=(nm,back)=>{const T=RACE.T,N=T.N,p=PT8_RING.pts[PT8_RING.marks[nm]];let b=1e18,k=0;for(let i=0;i<N;i++){const d=(T.x[i]-p[0])**2+(T.z[i]-p[1])**2;if(d<b){b=d;k=i}}k=((k-back)%N+N)%N;const c=RACE.cars[0];c.x=T.x[k];c.z=T.z[k];c.y=T.y[k]+.6;c.yaw=T.psi[k];c.vx=c.vy=c.vz=0;c.idx=k;c.unw=k;c.cy=T.psi[k];c.camY=T.y[k]+1;RACE.scene.userData.ringTiles.update(c.x,c.z,1e9);return k};return 1})()"], ["js", "TP('HOHE ACHT',40)"], ["wait", 2500], ["shot", "A"], ["js", "(()=>{const sc=RACE.scene,o={};sc.traverse(m=>{if(!m.isMesh)return;const g=m.geometry;if(!g.boundingSphere)g.computeBoundingSphere();const r=g.boundingSphere.radius*Math.max(m.scale.x,m.scale.y,m.scale.z);if(r>150){const k=g.type+':'+Math.round(r)+':'+(m.parent&&m.parent.name)+':'+(m.material&&m.material.color?m.material.color.getHexString():'');o[k]=(o[k]||0)+1}});return JSON.stringify(o)})()"], ["js", "(()=>{RACE.scene.traverse(m=>{if(m.isMesh&&m.geometry.type==='ConeGeometry'&&m.geometry.parameters.radius>50)m.visible=false});return 1})()"], ["wait", 800], ["shot", "B"], ["js", "(()=>{const t=RACE.scene.getObjectByName('ringTiles');t.visible=false;return 1})()"], ["wait", 800], ["shot", "C"]]