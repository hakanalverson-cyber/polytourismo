["js","(()=>{const out={};for(const tr of [14,15,0,4]){PT8.launch(Object.assign(tr>=14?{rally:true,circuit:true}:{},{mode:'mp',track:tr,laps:1,humans:[{id:'merc',alt:0}],ai:[]}));const c=RACE.cars[0];c.forceAI=1;c.ai={skill:1,lat:0,name:'T'};let air=0,ev=0,pa=false,mvy=0,t=0;for(let i=0;i<60*400;i++){step(1/60);if(RACE.state==='count'&&i>60*20)RACE.state='race';if(RACE.state!=='race')continue;if((c.lapT||[]).length>=1)break;t++;const a=c.m.wheels.every(w=>!w.g)&&c.sp>8&&!(RACE.T.jumps&&RACE.T.jumps.length);if(a){air++;if(!pa)ev++}pa=a;if(c.respT<=0)mvy=Math.max(mvy,c.vy)}out[tr]={air,ev,mvy:+mvy.toFixed(1),lap:(c.lapT||[]).map(x=>+x.toFixed(1))};PT8.cleanupRace&&PT8.cleanupRace()}return JSON.stringify(out)})()"]]
