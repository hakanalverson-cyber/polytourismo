["js","(()=>{const out={};for(const tr of [14,15]){PT8.launch({mode:'mp',track:tr,laps:1,humans:[{id:'merc',alt:0}],ai:PT8.makeAI({n:7,classes:['S'],skill:.97,rally:false}),trackRace:true,rolling:false});const cs=RACE.cars.filter(c=>!c.human);const cls=cs.map(c=>(PT8.classOf?PT8.classOf(c.cs):(c.cs.cls||'?'))+':'+c.cs.id).join(',');const l0=cs.map(c=>c.lane0==null?'x':c.lane0.toFixed(1)).join(',');for(let i=0;i<60*6;i++){step(1/60);if(RACE.state==='count')RACE.state='race'}const lat=cs.map(c=>PT8.latOf?PT8.latOf(RACE.T,c).toFixed(1):'?').join(',');out[tr]={cls,l0,lat,hasSlots:!!(RACE.T.d.cartoon&&RACE.T.d.cartoon.slots)};PT8.cleanupRace()}return JSON.stringify(out)})()"]]
