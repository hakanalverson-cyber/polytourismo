[["wait",2000],["js","(()=>{PT8.launch({rally:true,circuit:true,mode:'mp',track:PT8.RING_IDX,laps:1,humans:[{id:'merc',alt:0}],ai:[]});const T=RACE.T,N=T.N,k=87,lat=-4.3,x=T.x[k]+Math.cos(T.psi[k])*lat,z=T.z[k]-Math.sin(T.psi[k])*lat;const c=[];for(let i=80;i<95;i++){const j=(i+1)%N,dx=T.x[j]-T.x[i],dz=T.z[j]-T.z[i],len2=dx*dx+dz*dz,f=((x-T.x[i])*dx+(z-T.z[i])*dz)/len2;c.push([i,+f.toFixed(3),+Math.sqrt(len2).toFixed(2),+T.y[i].toFixed(2),+T.psi[i].toFixed(4),T.gap[i]])}return JSON.stringify({c,surf:T.surf(x,z,T.y[k]+1),surf2:T.surf(x+.01,z,T.y[k]+1),wrapped:T.surf.toString().slice(0,300)})})()"]]
