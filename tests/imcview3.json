[["wait", 2000], ["js", "(()=>{const t=document.getElementById('ptTitle');if(t)t.click();return 1})()"], ["wait", 2500], ["js", "(()=>{PT8.launch({rally:true,circuit:true,mode:'mp',track:15,laps:1,humans:[{id:'merc',alt:0}],ai:[]});window.VIEW=(frac,h,ah,lat)=>{const T=RACE.T,N=T.N,k=Math.floor(N*frac),c=Math.cos(T.psi[k]),s=Math.sin(T.psi[k]),l=lat||0;const cam=new THREE.PerspectiveCamera(60,16/9,.1,3000);const x=T.x[k]+c*l,z=T.z[k]-s*l;cam.position.set(x,T.y[k]+h,z);const k2=(k+(ah||12))%N;cam.lookAt(T.x[k2],T.y[k2]+(h>20?0:1),T.z[k2]);window.drawRace=()=>{R.render(RACE.scene,cam)};return k};window.TINT=()=>{const col={'imc_#d2d2d2':0xff00ff,imc_grass_2:0xff0000,imc_grass_1:0x0000ff,imc_gravel:0xffff00,imc_road:0x00ffff,imc_rock:0xff8800,imc_logo:0x888888,imc_IMOLA:0x00ff00,imc_garages_imola:0x8000ff,imc_banners:0x000000,imc_c:0xffffff,imc_fence:0x804000,imc_baloon:0x404040,imc_tyres:0x404040};RACE.scene.traverse(o=>{if(col[o.name]!=null){if(o.name==='imc_c'){o.material.vertexColors=false}o.material.map=null;o.material.color.setHex(col[o.name]);o.material.needsUpdate=true}});return 1};return 1})()"], ["js", "VIEW(0.3,8,20,-30)"], ["wait", 1500], ["shot", "s0"], ["js", "VIEW(0.3,8,20,30)"], ["wait", 1500], ["shot", "s1"], ["js", "VIEW(0.34,8,20,-30)"], ["wait", 1500], ["shot", "s2"], ["js", "VIEW(0.34,8,20,30)"], ["wait", 1500], ["shot", "s3"]]