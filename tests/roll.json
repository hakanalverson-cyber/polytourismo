["js","(()=>{const out={};for(const roll of [false,true]){PT8.launch({mode:'mp',track:14,laps:1,humans:[{id:'merc',alt:0}],ai:PT8.makeAI({n:5,classes:['B','A'],skill:.88,rally:false}),rolling:roll,trackRace:true});const c=RACE.cars[0];c.forceAI=1;c.ai={skill:.9,lat:0,name:'T'};const g0=RACE.cars.map(k=>Math.round(k.unw*RACE.T.sp));let gT=null,ex=0,pe=RACE.cars.map(()=>0);for(let i=0;i<60*260;i++){step(1/60);if(RACE.green&&gT==null){gT=+(RACE.t).toFixed(1);out.gap=RACE.cars.map(k=>Math.round(k.unw*RACE.T.sp))}RACE.cars.forEach((k,j)=>{if(k.exp>0&&!pe[j])ex++;pe[j]=k.exp>0});if(RACE.state==='done'||RACE.cars.every(k=>k.fin))break}out[roll?'roll':'stand']={g0,gT,ex,green:!!RACE.green,laps:RACE.cars.map(k=>(k.lapT||[]).map(x=>+x.toFixed(1))[0]),st:RACE.state};PT8.cleanupRace()}return JSON.stringify(out)})()"]]
