[["wait",2000],["js","(()=>{const o={};for(const tr of [0,15,14]){const ids=['c102','merc','c102','merc','c102','merc','c102'];PT8.launch({mode:'mp',rally:true,circuit:true,track:tr,laps:1,humans:[{id:'merc',alt:0}],ai:ids.map((id,i)=>({id,alt:0,skill:.9}))});step(1/60);const c0=RACE.cars[0];{const f=[Math.sin(c0.yaw),Math.cos(c0.yaw)];o[tr]=RACE.cars.map(c=>{const dx=c.x-c0.x,dz=c.z-c0.z;return[Math.round(dx*f[0]+dz*f[1]),Math.round(dx*f[1]-dz*f[0])]})};PT8.cleanupRace&&PT8.cleanupRace()}return JSON.stringify(o)})()"]]
