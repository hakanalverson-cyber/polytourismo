["js","(()=>{const ip0=PT8.inPost;PT8.inPost=(c,dt)=>{if(c.human){const a=PT8.aiInput(c,dt);c.in={th:a.th,br:a.br,st:a.st,hb:0}}if(ip0)ip0(c,dt)};PT8.launch({mode:'mp',track:14,laps:1,humans:[{id:'merc',alt:0}],ai:[],trackRace:true});const c=RACE.cars[0];c.ai={skill:1,lat:0,name:'T'};const T=RACE.T,N=T.N;const r=[];let t=0;while(t<70){t+=1/60;step(1/60);if(RACE.state==='count')RACE.state='race';if(Math.round(t*60)%120===0){const i=((c.idx|0)%N+N)%N,j=(i+5)%N,sl=Math.atan2(T.y[j]-T.y[i],5*T.sp);r.push(Math.round(c.unw*T.sp)+':p'+(c.pitch*57.3).toFixed(1)+'/s'+(sl*57.3).toFixed(1)+'/vy'+(Math.atan2(c.vy||0,c.sp||1)*57.3).toFixed(1))}}PT8.cleanupRace();PT8.inPost=ip0;return r.join(' ')})()"]]
