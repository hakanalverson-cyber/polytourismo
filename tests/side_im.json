[["wait", 2000], ["js", "(()=>{const t=document.getElementById('ptTitle');if(t)t.click();return 1})()"], ["wait", 2500], ["js", "(()=>{PT8.launch({mode:'mp',rally:true,circuit:true,track:15,laps:1,humans:[{id:'merc',alt:0}],ai:[]});RACE.state='race';window.TPO=(k,off)=>{const T=RACE.T,N=T.N;k=((k%N)+N)%N;const c=RACE.cars[0],cs=Math.cos(T.psi[k]),sn=Math.sin(T.psi[k]),l=T.hw[k]+off;c.x=T.x[k]+cs*l;c.z=T.z[k]-sn*l;c.y=T.terr?T.terr(c.x,c.z)+.6:T.y[k]+.6;c.yaw=T.psi[k]+.35;c.vx=c.vy=c.vz=0;c.idx=k;c.unw=k;c.cy=c.yaw;c.camY=c.y+1;c.exp=0;const u=RACE.scene.userData.ringTiles;if(u)u.update(c.x,c.z,1e9)};return RACE.T.N})()"], ["js", "TPO(Math.round(RACE.T.N*0.1),9)"], ["wait", 1500], ["shot", "s10"], ["js", "TPO(Math.round(RACE.T.N*0.3),9)"], ["wait", 1500], ["shot", "s30"], ["js", "TPO(Math.round(RACE.T.N*0.55),9)"], ["wait", 1500], ["shot", "s55"], ["js", "TPO(Math.round(RACE.T.N*0.8),9)"], ["wait", 1500], ["shot", "s80"]]