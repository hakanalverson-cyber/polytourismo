[["js", "(()=>{const t=document.getElementById('ptTitle');if(t)t.click();return 1})()"], ["wait", 2000], ["js", "(()=>{window.PT8_AIC=.8;PT8.launch({mode:'mp',track:21,laps:3,humans:[{id:'merc',alt:0}],ai:[],trackRace:true});const c=RACE.cars[0];c.forceAI=1;c.ai={skill:1,lat:0,name:'T'};const T=RACE.T,N=T.N,RL=PT8.racingLine(T);const log=[];\n for(let f=0;f<60*130;f++){step(1/60);if(RACE.state==='count'&&f>30)RACE.state='race';if(RACE.state!=='race')continue;if(f%30===0)log.push([+(RACE.t).toFixed(0),c.idx|0,+(c.unw*T.sp).toFixed(0),+c.sp.toFixed(1),+(c._tg||0).toFixed(1),+(c.in.th||0).toFixed(1),+(c.in.br||0).toFixed(1),+(c.in.st||0).toFixed(2),+(PT8.latOf(T,c)-RL[((c.idx|0)%N+N)%N]).toFixed(1),+(c.stuck||0).toFixed(1),c.respT>0?1:0])}\n return JSON.stringify(log)})()"]]