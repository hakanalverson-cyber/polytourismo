[["wait", 2000], ["js", "(()=>{const t=document.getElementById('ptTitle');if(t)t.click();return 1})()"], ["wait", 2500], ["js", "(()=>{PT8.launch({mode:'mp',rally:true,circuit:true,track:PT8.RING_IDX,laps:1,humans:[{id:'merc',alt:0}],ai:[]});RACE.state='race';window.TK=(k)=>{const T=RACE.T,N=T.N;k=((k%N)+N)%N;const c=RACE.cars[0];c.x=T.x[k];c.z=T.z[k];c.y=T.y[k]+1.0;c.yaw=T.psi[k];c.vx=c.vy=c.vz=0;c.idx=k;c.unw=k;c.cy=T.psi[k];c.camY=T.y[k]+1;RACE.scene.userData.ringTiles.update(c.x,c.z,1e9);return k};window.TP=(nm,back)=>{const T=RACE.T,N=T.N,p=PT8_RING.pts[PT8_RING.marks[nm]];let b=1e18,k=0;for(let i=0;i<N;i++){const d=(T.x[i]-p[0])**2+(T.z[i]-p[1])**2;if(d<b){b=d;k=i}}k=((k-back)%N+N)%N;const c=RACE.cars[0];c.x=T.x[k];c.z=T.z[k];c.y=T.y[k]+1.0;c.yaw=T.psi[k];c.vx=c.vy=c.vz=0;c.idx=k;c.unw=k;c.cy=T.psi[k];c.camY=T.y[k]+1;RACE.scene.userData.ringTiles.update(c.x,c.z,1e9);return k};return 1})()"], ["js", "(()=>{const T=RACE.T;let m=1e9,k=0;for(let i=0;i<T.N;i++)if(T.y[i]<m){m=T.y[i];k=i}window.KMIN=k;return k+' '+m})()"], ["js", "(()=>{const T=RACE.T,N=T.N;let mx=0,at=null,n1=0,n=0;for(let k=0;k<N;k+=20)for(const side of[-1,1]){let prev=null;const c=Math.cos(T.psi[k]),s=Math.sin(T.psi[k]);for(let l=48;l<=640;l+=16){const x=T.x[k]+c*l*side,z=T.z[k]-s*l*side,h=terrainBed(T,x,z);if(prev!=null){const g=Math.abs(h-prev)/16;n++;if(g>1)n1++;if(g>mx){mx=g;at=[k,side,l]}}prev=h}}return JSON.stringify({mx,at,n1,n})})()"]]