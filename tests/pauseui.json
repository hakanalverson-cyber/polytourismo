["js","(()=>{const out=[];const pz=document.getElementById('pause');for(const e of document.body.querySelectorAll('*')){if(pz.contains(e)||e.contains(pz))continue;const cs=getComputedStyle(e);if(cs.display==='none'||cs.visibility==='hidden'||+cs.opacity===0)continue;const r=e.getBoundingClientRect();if(r.width<2||r.height<2)continue;if(e.tagName==='CANVAS'&&r.width>1000)continue;let p=e.parentElement,ok=true;while(p&&p!==document.body){const c2=getComputedStyle(p);if(c2.display==='none'||c2.visibility==='hidden'||+c2.opacity===0){ok=false;break}p=p.parentElement}if(!ok)continue;if(e.parentElement!==document.body&&!(cs.position==='fixed'||cs.position==='absolute'))continue;out.push((e.id||e.className||e.tagName)+' '+cs.position+' '+Math.round(r.x)+','+Math.round(r.y)+' '+Math.round(r.width)+'x'+Math.round(r.height))}return out.slice(0,60).join(' | ')})()"]]
