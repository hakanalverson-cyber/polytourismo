[["wait", 2000], ["js", "(()=>{PT8.launch({mode:'mp',rally:true,circuit:true,track:14,laps:1,humans:[{id:'c102',alt:0}],ai:[]});const T=RACE.T;const o={N:T.N,sp:T.sp,y:[],tr:[],hw:[]};for(let k=480;k<530;k+=2){o.y.push(+T.y[k].toFixed(2));o.tr.push(+T.terr(T.x[k],T.z[k]).toFixed(2));o.hw.push(+T.hw[k].toFixed(1))}\nconst k=508,bb=new THREE.Box3(),hits=[];RACE.scene.updateMatrixWorld(true);RACE.scene.traverse(m=>{if(!m.isMesh||m.isInstancedMesh)return;bb.setFromObject(m);if(!isFinite(bb.min.x))return;const cx=Math.max(bb.min.x,Math.min(T.x[k],bb.max.x)),cz=Math.max(bb.min.z,Math.min(T.z[k],bb.max.z));if(Math.hypot(cx-T.x[k],cz-T.z[k])<15&&bb.max.x-bb.min.x<200)hits.push([m.geometry.type,m.name,bb.min.y.toFixed(1),bb.max.y.toFixed(1),(bb.max.x-bb.min.x).toFixed(0),(bb.max.z-bb.min.z).toFixed(0)])});o.hits=hits.slice(0,30);\no.walls=[];for(let q=495;q<520;q+=3)o.walls.push([T.wall?T.wall[q]:null,T.wh?T.wh[q]:null,T.tn?T.tn[q]:null]);return JSON.stringify(o)})()"]]