["js","(()=>{const ip0=PT8.inPost;PT8.inPost=(c,dt)=>{if(c.human&&window.KB){const a=PT8.aiInput(c,dt);c.in={th:a.th,br:a.br,st:Math.abs(a.st)>.1?Math.sign(a.st):0,hb:0}}if(ip0)ip0(c,dt)};window.KB=1;const out={};for(const tr of [14,15]){PT8.launch({mode:'mp',track:tr,laps:1,humans:[{id:window.CAR||'merc',alt:0}],ai:[],trackRace:true});const c=RACE.cars[0];c.ai={skill:1,lat:0,name:'T'};let off=0,n=0,ex=0,pe=0,vmax=0;for(let i=0;i<60*400;i++){step(1/60);if(RACE.state==='count')RACE.state='race';if((c.lapT||[]).length>=1)break;n++;if(!c.onRoad)off++;if(c.exp>0&&!pe)ex++;pe=c.exp>0;vmax=Math.max(vmax,c.sp)}out[tr]={lap:(c.lapT||[]).map(x=>+x.toFixed(1)),off:+(off/n*100).toFixed(1),ex,vmax:Math.round(vmax*2.237)};PT8.cleanupRace()}window.KB=0;return JSON.stringify(out)})()"]]
